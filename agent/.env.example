# Copy to .env.local for local development (console/dev modes).
# For the LiveKit Cloud hosted deployment, push these via
# `lk agent update-secrets` instead — see agent/README.md.

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI Realtime API key — powers both the voice conversation and the
# native video perception (passport reading), in a single session.
OPENAI_API_KEY=

# Resend API key, for the contract-email tool.
RESEND_API_KEY=
